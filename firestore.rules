rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null
      && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function smallText(text, max) { return text is string && text.size() > 0 && text.size() <= max; }
    function isHost(roomId) {
      return signedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
    }
    function isMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId))
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    match /users/{uid} {
      allow get: if me(uid);
      allow list: if false;
      allow create, update: if me(uid) && !('password' in request.resource.data)
        && request.resource.data.id == uid
        && request.resource.data.keys().hasOnly([
          'id','username','displayName','avatarDataUrl','yahooTitle','characterId','level',
          'currentExp','coins','totalGames','totalWins','activeMarkerId',
          'activeTicketSkinId','activeThemeId','activeFrameId','unlockedItemIds',
          'lastDailySpinTime','updatedAt'
        ]);
      allow delete: if false;
    }
    match /users/{uid}/spinClaims/{dayKey} {
      allow get: if me(uid);
      allow list: if false;
      allow create: if me(uid) && dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /rooms/{roomId} {
      // For the live game, the client listens to exactly rooms/{roomId}.
      // Private tickets remain in rooms/{roomId}/members/{uid} to preserve write ownership.
      function rosterAddOwn() {
        let delta = request.resource.data.roster.diff(resource.data.roster);
        return delta.addedKeys().hasOnly([request.auth.uid])
          && delta.addedKeys().size() == 1
          && delta.removedKeys().size() == 0
          && delta.changedKeys().size() == 0
          && request.resource.data.roster.keys().size() == request.resource.data.memberCount
          && request.resource.data.roster[request.auth.uid].name is string
          && request.resource.data.roster[request.auth.uid].name.size() <= 48
          && request.resource.data.roster[request.auth.uid].name ==
            getAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.name;
      }
      function rosterRemoveOwn() {
        let delta = request.resource.data.roster.diff(resource.data.roster);
        return delta.addedKeys().size() == 0
          && delta.removedKeys().hasOnly([request.auth.uid])
          && delta.removedKeys().size() == 1
          && delta.changedKeys().size() == 0
          && request.resource.data.roster.keys().size() == request.resource.data.memberCount;
      }

      allow get: if signedIn();
      // Rules are not filters. Waiting-only public lobby query is essential.
      allow list: if signedIn() && resource.data.isPrivate == false
        && resource.data.status == 'WAITING' && resource.data.liveVersion == 2
        && request.query.limit <= 20;
      allow create: if signedIn()
        && request.resource.data.id == roomId
        && request.resource.data.code == roomId
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].id == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.roster is map
        && request.resource.data.roster.keys().size() == 1
        && request.resource.data.roster.keys().hasAll([request.auth.uid])
        && request.resource.data.roster[request.auth.uid].name == request.resource.data.hostName
        && request.resource.data.liveVersion == 2
        && request.resource.data.gameRevision == 0
        && request.resource.data.currentBallNumber == null
        && request.resource.data.calledHistory == []
        && request.resource.data.maxPlayers >= 2 && request.resource.data.maxPlayers <= 100
        && request.resource.data.status == 'WAITING'
        && smallText(request.resource.data.name, 70)
        && !('password' in request.resource.data)
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.id == request.auth.uid;
      allow update: if signedIn() && resource.data.liveVersion == 2 && (
        // The HOST publishes an actual game or music transition in one document write.
        (resource.data.hostId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','currentBallNumber','calledHistory','winnerPlayerName','winnerRow','countdownEndsAt',
            'updatedAt','audioPhase','audioTrack','audioStartedAt','soundpackId','roundId','gameRevision'
          ])
          && request.resource.data.gameRevision == resource.data.gameRevision + 1
          && (
            (resource.data.status == 'WAITING' && request.resource.data.status in ['WAITING','COUNTDOWN'])
            || (resource.data.status == 'COUNTDOWN' && request.resource.data.status in ['COUNTDOWN','CALLING'])
            || (resource.data.status == 'CALLING' && request.resource.data.status in ['CALLING','GAME_OVER'])
            || (resource.data.status == 'GAME_OVER' && request.resource.data.status in ['GAME_OVER','WAITING'])
          )
          && request.resource.data.calledHistory is list
          && request.resource.data.calledHistory.size() <= 90)
        // Updating HOST display name only (separate from gameplay).
        || (resource.data.hostId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostName']))
        // Atomic departure of HOST: successor must already be a member.
        || (resource.data.hostId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hostId','hostName','memberCount','roster'
          ])
          && request.resource.data.hostId != request.auth.uid
          && request.resource.data.roster.keys().hasAll([request.resource.data.hostId])
          && rosterRemoveOwn()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.resource.data.hostId))
          && !existsAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.resource.data.hostId)).data.isHost == true
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && request.resource.data.memberCount >= 1)
        // One join: one private member document + public count/roster in SAME transaction.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','roster'])
          && resource.data.status == 'WAITING'
          && !exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
          && rosterAddOwn()
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.memberCount <= resource.data.maxPlayers)
        // One normal departure: no changes to another player's roster entry.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','roster'])
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
          && !existsAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
          && rosterRemoveOwn()
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && request.resource.data.memberCount >= 1)
      );
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));

      // Deprecated legacy state docs must not create a second live channel.
      match /state/{stateId} { allow read, write: if false; }
      match /members/{uid} {
        allow get: if me(uid) || isHost(roomId);
        allow list: if isHost(roomId) && request.query.limit <= 100;
        allow create: if me(uid) && request.resource.data.id == uid
          && request.resource.data.isBot == false
          && request.resource.data.joinedAt == request.time
          && request.resource.data.tickets is list && request.resource.data.tickets.size() <= 1
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.liveVersion == 2
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.roster.keys().hasAll([uid])
          && request.resource.data.isHost ==
            (getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == uid)
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberCount >= 1
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberCount <=
            getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.maxPlayers
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'WAITING'
          && (
            // Creating new room: both room and member are created atomically.
            (getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == uid
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberCount == 1)
            // Joining existing room: memberCount must increase by exactly one.
            || (exists(/databases/$(database)/documents/rooms/$(roomId))
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberCount ==
                get(/databases/$(database)/documents/rooms/$(roomId)).data.memberCount + 1)
          );
        allow update: if (
          (signedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
            && uid != request.auth.uid
            && resource.data.isHost == false && request.resource.data.isHost == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHost'])
            && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == uid
            && !existsAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)))
          || (me(uid) && request.resource.data.id == uid
            && request.resource.data.isHost == resource.data.isHost
            && request.resource.data.isBot == false
            && request.resource.data.tickets is list && request.resource.data.tickets.size() <= 1
            // Once audio calling starts, all ticket changes are rejected by server Rules.
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tickets','isReady'])
              || get(/databases/$(database)/documents/rooms/$(roomId)).data.status in ['WAITING','COUNTDOWN'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['joinedAt'])
              || (!('joinedAt' in resource.data) && request.resource.data.joinedAt == request.time)))
        );
        allow delete: if me(uid) && (
          (isHost(roomId) && !existsAfter(/databases/$(database)/documents/rooms/$(roomId)))
          || (existsAfter(/databases/$(database)/documents/rooms/$(roomId))
            && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberCount ==
              get(/databases/$(database)/documents/rooms/$(roomId)).data.memberCount - 1
            && !getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.roster.keys().hasAny([uid]))
        );
      }
      match /claims/{claimId} {
        allow get: if isHost(roomId);
        allow list: if isHost(roomId) && request.query.limit <= 20;
        allow create: if isMember(roomId)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'CALLING'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.roundId == get(/databases/$(database)/documents/rooms/$(roomId)).data.roundId
          && claimId == request.resource.data.roundId + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId','roundId','numbers','createdAt'])
          && request.resource.data.numbers is list && request.resource.data.numbers.size() == 5
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /messages/{messageId} {
        // The query must include where('createdAt', '>=', own joinedAt).
        // Chat from before this player entered the room is never readable.
        allow get: if isMember(roomId)
          && resource.data.createdAt >= get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.joinedAt;
        allow list: if isMember(roomId) && request.query.limit <= 40
          && resource.data.createdAt >= get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.joinedAt;
        allow create: if isMember(roomId) && request.resource.data.senderId == request.auth.uid
          && smallText(request.resource.data.text, 500)
          && request.resource.data.channel == 'room'
          && request.resource.data.keys().hasOnly([
            'senderId','senderName','characterId','avatar','text','timestamp','channel','isVipEmoji','isBuzz','createdAt'
          ])
          && smallText(request.resource.data.senderName, 48)
          && (!('avatar' in request.resource.data) || (
            request.resource.data.avatar is string && request.resource.data.avatar.size() <= 2048))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /reactions/{reactionId} {
        allow get: if isMember(roomId);
        allow list: if isMember(roomId) && request.query.limit <= 10;
        allow create: if isMember(roomId) && request.resource.data.senderId == request.auth.uid
          && smallText(request.resource.data.emoji, 12)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    // Lightweight FIFO queue for Spark admission: visitors wait on Firestore
    // without consuming RTDB persistent connections. Lease refresh only while waiting.
    match /online_waiting/{uid} {
      allow get: if me(uid);
      allow list: if signedIn() && request.query.limit <= 50;
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly(['joinedAt','lastSeen'])
        && request.resource.data.joinedAt == request.time
        && request.resource.data.lastSeen == request.time;
      allow update: if me(uid)
        && request.resource.data.keys().hasOnly(['joinedAt','lastSeen'])
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.lastSeen == request.time;
      allow delete: if me(uid);
    }
    match /chat_sessions/{uid} {
      allow get: if me(uid);
      allow list: if false;
      allow create, update: if me(uid) && request.resource.data.keys().hasOnly(['uid','joinedAt'])
        && request.resource.data.uid == uid && request.resource.data.joinedAt == request.time;
      allow delete: if false;
    }
    match /world_messages/{messageId} {
      // Rules are NOT filters. The frontend MUST query with createdAt >= joinedAt.
      allow get: if signedIn() && exists(/databases/$(database)/documents/chat_sessions/$(request.auth.uid))
        && resource.data.createdAt >= get(/databases/$(database)/documents/chat_sessions/$(request.auth.uid)).data.joinedAt;
      allow list: if signedIn() && request.query.limit <= 40
        && exists(/databases/$(database)/documents/chat_sessions/$(request.auth.uid))
        && resource.data.createdAt >= get(/databases/$(database)/documents/chat_sessions/$(request.auth.uid)).data.joinedAt;
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
        && smallText(request.resource.data.text, 500)
        && request.resource.data.channel == 'world'
        && request.resource.data.keys().hasOnly([
          'senderId','senderName','characterId','avatar','text','timestamp','channel','isVipEmoji','isBuzz','createdAt'
        ])
        && smallText(request.resource.data.senderName, 48)
        && (!('avatar' in request.resource.data) || (
          request.resource.data.avatar is string && request.resource.data.avatar.size() <= 2048))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
