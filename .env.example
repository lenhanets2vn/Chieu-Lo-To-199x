# Cấu hình Firebase cho Render / Vercel (Vite)
# Sao chép file thành .env.local ở máy cá nhân hoặc nhập các KEY dưới đây trên Dashboard.
# Dữ liệu VITE_* được đưa vào bundle JavaScript của trình duyệt; tuyệt đối không đặt
# service-account JSON, Firebase Admin SDK private key, mật khẩu, hoặc token riêng tư ở đây.
# Nếu không nhập biến nào, ứng dụng dùng firebase-applet-config.json hiện có.
# Nếu nhập một biến VITE_FIREBASE_* bất kỳ, phải nhập đủ cả 6 biến bắt buộc.

VITE_FIREBASE_API_KEY=AIzaSyDBxXyrffg9Mauyr0vYmoZyR4GG_RiV0Q4
VITE_FIREBASE_AUTH_DOMAIN=loto-83a1a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=loto-83a1a
VITE_FIREBASE_APP_ID=1:401789333507:web:761e676210b64b50d1de36
VITE_FIREBASE_MESSAGING_SENDER_ID=401789333507
VITE_FIREBASE_STORAGE_BUCKET=loto-83a1a.firebasestorage.app

# Bắt buộc nhập nếu đang dùng Firestore database có tên riêng; không được bỏ trống:
VITE_FIRESTORE_DATABASE_ID=(default)

# Chỉ cần nếu có Analytics (ứng dụng hiện chưa sử dụng Analytics):
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# RTDB: Sao chép ĐÚNG database URL từ Firebase Console > Realtime Database > Data.
# Nếu để trống, ứng dụng tiếp tục chạy theo cơ chế Firestore cũ; không bật hàng chờ.
# Khác nhau theo vùng: https://<id>-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
